# Local PostgreSQL connection. Use a JDBC URL.
DB_URL=jdbc:postgresql://localhost:5432/knowledgegap
DB_USERNAME=postgres
DB_PASSWORD=replace-me

# Generate a long random value; never reuse this example value.
JWT_SECRET=replace-with-a-long-random-secret

# Optional administrative setup keys.
ADMIN_REGISTRATION_KEY=
HR_SETUP_KEY=

# Comma-separated trusted browser origins.
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5174
APP_WS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
